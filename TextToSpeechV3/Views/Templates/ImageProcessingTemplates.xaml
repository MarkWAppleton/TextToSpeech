<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:selectors="clr-namespace:TextToSpeech.View.DataTemplateSelectors">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="ResizeImageProcessingConfigTemplate.xaml"/>
		<ResourceDictionary Source="GrayScaleImageProcessingConfigTemplate.xaml"/>
		<ResourceDictionary Source="GaussianBlurImageProcessingConfigTemplate.xaml"/>
		<ResourceDictionary Source="MedianBlurImageProcessingConfigTemplate.xaml"/>
		<ResourceDictionary Source="ThresholdingImageProcessingConfigTemplate.xaml"/>
	</ResourceDictionary.MergedDictionaries>

	<selectors:ImageProcessingStepDataTemplateSelector 
		x:Key="imageProcessingStepDataTemplateSelector"
		ResizeImageProcessingConfigTemplate="{StaticResource ResizeImageProcessingConfigTemplate}" 
		GrayScaleImageProcessingConfigTemplate="{StaticResource GrayScaleImageProcessingConfigTemplate}" 
		GaussianBlurImageProcessingConfigTemplate="{StaticResource GaussianBlurImageProcessingConfigTemplate}" 
		MedianBlurImageProcessingConfigTemplate="{StaticResource MedianBlurImageProcessingConfigTemplate}" 
		ThresholdingImageProcessingConfigTemplate="{StaticResource ThresholdingImageProcessingConfigTemplate}" 
		/>
</ResourceDictionary>
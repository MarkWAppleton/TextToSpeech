<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:converters="clr-namespace:TextToSpeech.Utility.Converters">

	<converters:FlagEnumMultiValueConverter x:Key="FlagEnumMultiValueConverter"/>
	<converters:FlagEnumConverter x:Key="FlagEnumConverter"/>
	
	<DataTemplate x:Key="ThresholdingImageProcessingConfigTemplate">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="auto"/>
				<RowDefinition Height="auto"/>
				<RowDefinition/>
			</Grid.RowDefinitions>

			<Label Grid.Row="0" Content="Thresholding" FontWeight="Bold"/>

			<Grid Grid.Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="auto"/>
					<ColumnDefinition/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition/>
					<RowDefinition/>
					<RowDefinition/>
				</Grid.RowDefinitions>

				<Label Grid.Column="0" Grid.Row="0" Content="Thresh"/>
				<TextBox x:Name="txtThresh" Grid.Column="1" Grid.Row="0" Text="{Binding ImageProcessingConfig.Thresh}" VerticalAlignment="Center"/>

				<Label Grid.Column="0" Grid.Row="1" Content="Maxval"/>
				<TextBox x:Name="txtMaxval" Grid.Column="1" Grid.Row="1" Text="{Binding ImageProcessingConfig.Maxval}" VerticalAlignment="Center"/>

				<Label Grid.Column="0" Grid.Row="2" Content="Types"/>
				<ComboBox Grid.Column="1" Grid.Row="2"
					ItemsSource="{Binding DataContext.ThresholdTypes, RelativeSource={RelativeSource AncestorType=Window}}">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal">
								<CheckBox Content="{Binding}">
									<CheckBox.IsChecked>
										<MultiBinding Converter="{StaticResource FlagEnumMultiValueConverter}" Mode="TwoWay">
											<Binding Path="DataContext.ImageProcessingConfig.Type" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
											<Binding Path="." />
										</MultiBinding>
									</CheckBox.IsChecked>
								</CheckBox>



								<!--<CheckBox Content="{Binding}"
                                  IsChecked="{Binding ImageProcessingConfig.Type, 
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                      Converter={StaticResource FlagEnumConverter},
                                                      ConverterParameter={Binding}}"/>-->
								

								<!--<CheckBox Content="{Binding}">
									<CheckBox.IsChecked>
										<MultiBinding Converter="{StaticResource FlagEnumMultiConverter}">
											<Binding Path="DataContext.ThresholdTypes" RelativeSource="{RelativeSource AncestorType=Window}"/>
											<Binding />
										</MultiBinding>
									</CheckBox.IsChecked>
								</CheckBox>-->

							</StackPanel>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
				
				<!--<ScrollViewer Grid.ColumnSpan="2" Grid.Row="2">
					<StackPanel>

						<ComboBox ItemsSource="{Binding DataContext.ThresholdTypes, RelativeSource={RelativeSource AncestorType=Window}}">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal">
										<CheckBox/>
										<TextBlock Text="{Binding}" />
									</StackPanel>
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>

					</StackPanel>
				</ScrollViewer>-->
			</Grid>
		</Grid>
	</DataTemplate>
</ResourceDictionary>